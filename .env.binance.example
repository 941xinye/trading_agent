# ============ 交易所配置示例：Binance 模式 ============
# 用法：把本文件的配置项合并进项目根目录的 .env（不要直接覆盖已有 .env，
#       否则会丢掉已填好的 LLM_API_KEY / WEBHOOK_* 等配置）。
# 也可不改 .env，单次命令加 --exchange binance 临时切换。

# 数据源：binance / gate（切回 Gate.io 改成 gate 即可）
EXCHANGE=binance

# 标的与周期：按交易所现货 XXX/USDT 填写，无需带后缀
SYMBOLS=BTC,ETH,SOL
QUOTE=USDT
TIMEFRAMES=1h,4h,1d
KLINE_LIMIT=300

# Binance 接口地址
# 现货：data-api.binance.vision，国内可直连，一般无需修改
# BINANCE_SPOT_BASE=https://data-api.binance.vision
# 永续：fapi.binance.com，国内多数网络不可达；不可达时持仓面自动按中性降级
# BINANCE_FUTURES_BASE=https://fapi.binance.com

# ---------- 代理（访问 Binance 永续时按需启用）----------
# 本地 HTTP 代理（Clash 常见 7890，v2rayN 常见 10809）
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# 本地 socks5 代理（已安装 PySocks）
# HTTPS_PROXY=socks5://127.0.0.1:1080
# HTTP_PROXY=socks5://127.0.0.1:1080
# 只让 Binance 走代理，境内数据源直连
# NO_PROXY=localhost,127.0.0.1,gateio.ws,stablecoins.llama.fi,api.blockchain.info,mempool.space,api.alternative.me,push2his.eastmoney.com,api.deepseek.com
# 或者把永续直接指向自建反向代理（需保留 /fapi 与 /futures 路径）
# BINANCE_FUTURES_BASE=https://your-proxy.example.com

# ---------- 与交易所无关的配置（沿用现有 .env 即可）----------
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=
# LLM_MODEL=deepseek-chat
# ALERT_INTERVAL=300
# ALERT_COOLDOWN=1800
# WEBHOOK_URL=
# WEBHOOK_SECRET=
