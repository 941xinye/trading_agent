# 观察列表（逗号分隔）
SYMBOLS=BTC,ETH,SOL
QUOTE=USDT
TIMEFRAMES=5m,1h,4h,1d
KLINE_LIMIT=300

# 行情/永续数据源：gate 或 binance（--exchange 可临时覆盖）
# 通过代理访问 Binance 时，把这里改成 EXCHANGE=binance
EXCHANGE=gate

# ============ 代理配置（可选，主要用于 Binance）============
# Binance 现货走 data-api.binance.vision（国内可直连）；
# 永续走 fapi.binance.com（国内多数网络不可达），需要代理时启用下面任一种方式。
#
# 方式一：本地 HTTP 代理（推荐）。requests 会自动读取标准代理变量，
#         地址换成你自己的代理端口（Clash 常见 7890，v2rayN 常见 10809）。
# HTTPS_PROXY=http://127.0.0.1:7890
# HTTP_PROXY=http://127.0.0.1:7890
# socks5 代理需先安装 PySocks：pip install pysocks，再写 socks5://127.0.0.1:1080
#
# 设置后所有 HTTPS 请求都会走代理；只让 Binance 走代理时，用 NO_PROXY 排除境内数据源：
# NO_PROXY=localhost,127.0.0.1,gateio.ws,stablecoins.llama.fi,api.blockchain.info,mempool.space,api.alternative.me,push2his.eastmoney.com,api.deepseek.com
#
# 若系统环境变量中已有同名代理，系统值优先（.env 不会覆盖已存在的变量）。
#
# 方式二：把 Binance 永续指向自建反向代理（需保留 /fapi 与 /futures 路径）
# BINANCE_FUTURES_BASE=https://your-proxy.example.com
# 现货接口一般无需修改，特殊网络下也可替换
# BINANCE_SPOT_BASE=https://data-api.binance.vision

# 大模型：任意 OpenAI 兼容接口。不填 API Key 时只走规则引擎。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# 告警
ALERT_INTERVAL=300
ALERT_COOLDOWN=1800
# 夜间静默时段（本地时区，支持跨零点；留空不启用）：期间告警只写 reports/alerts.log
ALERT_QUIET_HOURS=
# 最低推送级别：info=全部推送；warning=只推送 warning（info 仍落盘）
ALERT_MIN_LEVEL=info
# 内置调度（main.py serve）的每日简报推送时间，24 小时制、逗号分隔
BRIEF_PUSH_TIMES=09:00,21:00
# 钉钉/飞书机器人 Webhook，留空则不推送
WEBHOOK_URL=
# 飞书机器人开启「签名校验」时填写 secret，未开启留空
WEBHOOK_SECRET=

# ============ 维护与清理 ============
# HTTP 磁盘缓存保留天数：启动时自动删除更早的缓存文件
CACHE_MAX_AGE_DAYS=7
# 缓存文件数上限：超出后按最旧优先淘汰
CACHE_MAX_FILES=3000
# 告警冷却记录保留小时数：超过后从 .state/alerts.json 清理
ALERT_STATE_TTL_HOURS=168

# ============ 日志 ============
# DEBUG / INFO / WARNING / ERROR，默认 INFO；daemon 输出到 reports/watch.log
LOG_LEVEL=INFO

# ============ 本地 API（main.py api）============
API_HOST=127.0.0.1
API_PORT=8080
# 非空时所有请求需带 X-API-Token 或 Authorization: Bearer <token>
# 对外暴露（--host 0.0.0.0）前务必设置
API_TOKEN=

# ============ 飞书双向机器人（main.py feishu-hook）============
# 使用飞书自建应用的事件订阅回调，在群内 @机器人 即可问答
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 「事件订阅」页面配置的 Verification Token，用于校验回调来源
FEISHU_VERIFY_TOKEN=
FEISHU_BOT_HOST=127.0.0.1
FEISHU_BOT_PORT=8787
